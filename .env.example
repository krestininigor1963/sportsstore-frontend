# ============================================================
# Пример переменных окружения для фронтенда (Next.js).
# Скопируйте в .env.local для локальной разработки или
# задайте эти переменные в Settings → Environment Variables на Vercel.
# ============================================================

# Базовый URL бэкенда (Express). Значение подставляется на этапе
# СБОРКИ (NEXT_PUBLIC_*), поэтому после смены нужен redeploy.
#
# Локальная разработка:
NEXT_PUBLIC_API_URL=http://localhost:5000

# Продакшен (Vercel): бэкенд должен быть доступен по HTTPS,
# иначе браузер не сохранит сессионные cookie (SameSite=None; Secure):
# NEXT_PUBLIC_API_URL=https://api.your-domain.com
